{
  "name": "ace-mr-studio-interactive-map",
  "version": "1.0.0",
  "description": "Interactive mixed-reality urban visualization platform with modular TypeScript architecture",
  "type": "module",
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "build:watch": "tsc --watch",
    "copy-assets": "node scripts/copy-assets.js",
    "dev": "npm-run-all --parallel build:watch serve",
    "serve": "http-server -p 8000 -c-1",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "maplibre",
    "visualization",
    "typescript",
    "interactive-map",
    "urban-planning"
  ],
  "author": "ACE MR Studio, Chalmers University of Technology",
  "license": "SEE LICENSE IN README",
  "devDependencies": {
    "@types/geojson": "^7946.0.14",
    "@types/three": "^0.163.0",
    "http-server": "^14.1.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "maplibre-gl": "^3.6.2",
    "three": "^0.163.0"
  }
}
